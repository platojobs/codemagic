"help.section.all" = "Common questions";
"help.footer" = "These answers match the app's current behavior. If a problem persists, record it in Feedback; feedback stays on this device.";
"help.expand" = "Expand";
"help.collapse" = "Collapse";
"help.question.pairing" = "What should I do if pairing fails?";
"help.answer.pairing" = "First confirm Bluetooth permission is Granted under Profile → Bluetooth, then make sure the device is powered on, in range, and not connected to another phone. Toggle system Bluetooth off and on, then scan again. The app never shows a system pairing dialog; it subscribes to heart rate, battery, temperature, or Nordic UART characteristics only after a successful connection.";
"help.question.connection" = "The device appears in scan but will not connect?";
"help.answer.connection" = "Move closer and confirm the device is still advertising; some devices stop advertising once another phone connects. Check the scan log under Profile → Local data for the connection failure reason. If it still fails, restart both the app and the device, then try again.";
"help.question.readings" = "Connected but readings do not update?";
"help.answer.readings" = "The app recognizes only four subscribed characteristics: heart rate 2A37, battery 2A19, temperature 2A6E, and Nordic UART 6E400003. NUS devices must output metric=value line by line, each frame at most 256 bytes and each line at most 64 characters. Non-conforming or out-of-range lines are dropped and written to the scan log. Synced local readings are kept for 7 days; unsynced readings are never pruned.";
"help.question.sync" = "Which side wins a sync conflict?";
"help.answer.sync" = "For the same field, the newer server version wins. If the server rejects a push, the app writes the server version back locally and reports a conflict in the Sync status; local changes are not silently deleted. Check the conflict count under Profile → Sync and retry manually.";
"help.question.household" = "How do I leave a household or transfer ownership?";
"help.answer.household" = "Use Profile → Household. An owner who still has other members cannot leave: the server rejects the request with 409, so transfer ownership or remove all members first. After transferring, you become a regular member and lose permission to rename the household, issue invitation codes, and remove members.";

